# osTicket Reforged — ambiente local das ferramentas
#
# FINALIDADE
# Este arquivo é lido somente por ferramentas locais de diagnóstico, testes e
# deploy. O osTicket NÃO lê este arquivo e continua usando include/ost-config.php,
# criado pelo instalador. A persistência definitiva de conexões permanece TBD.
#
# SEGURANÇA
# - Não faça commit deste arquivo.
# - Use somente contas e dados de homologação.
# - Não cole chave privada; informe apenas o caminho local da chave.
# - Não exiba este arquivo, senhas ou tokens em logs e saídas de comandos.
# - Mantenha as barreiras de escrita desativadas até autorizar uma operação mutável.
# - Deixe campos não utilizados vazios.
#
# COMO PREENCHER
# Substitua somente o conteúdo após "=". Não adicione aspas, salvo quando a
# ferramenta adotada exigir. Consulte docs/development/HOMOLOGATION_ENVIRONMENT.md.

# -----------------------------------------------------------------------------
# IDENTIFICAÇÃO DO AMBIENTE
# -----------------------------------------------------------------------------
# Valor fixo para impedir uso acidental em produção.
OSTR_ENVIRONMENT=homologation

# URL pública inicial da instalação de homologação.
# Onde obter: painel do servidor web, configuração do virtual host ou provedor.
# Exemplo: https://suporte-homolog.exemplo.com
OSTR_BASE_URL=

# Fuso usado nos testes e na correlação de logs.
# Onde obter: configuração acordada para a homologação.
OSTR_TIMEZONE=America/Sao_Paulo

# Identificador não secreto desta instalação para mensagens e artefatos.
# Onde obter: escolha um nome curto, por exemplo osticket-hml.
OSTR_INSTANCE_NAME=

# Stack local selecionada para a homologação atual.
OSTR_WEB_STACK=xampp

# -----------------------------------------------------------------------------
# PHP LOCAL
# -----------------------------------------------------------------------------
# Caminho absoluto do php.exe usado por lint, CLI e ferramentas locais.
# Onde obter no Windows: Get-Command php; se não estiver no PATH, localizar a
# instalação PHP aprovada.
OSTR_PHP_VERSION_EXPECTED=8.2
OSTR_PHP_EXECUTABLE=C:\xampp\php\php.exe

# Caminho do php.ini carregado pelo PHP CLI local.
# Onde obter: executar "php --ini" sem imprimir variáveis deste arquivo.
OSTR_PHP_INI_PATH=C:\xampp\php\php.ini

# Caminho local de um log PHP acessível às ferramentas.
# Onde obter: diretiva error_log do php.ini local.
OSTR_PHP_ERROR_LOG_LOCAL=C:\xampp\php\logs\php_error_log

# Caminho do diretório temporário exclusivo das ferramentas.
# Onde obter: escolha uma pasta gravável fora do código implantado.
OSTR_LOCAL_TEMP_PATH=C:\xampp\tmp

# Caminho do executável e da configuração principal do Apache no XAMPP.
# Onde obter normalmente: C:\xampp\apache\bin\httpd.exe e
# C:\xampp\apache\conf\httpd.conf. Confirme os caminhos da instalação real.
OSTR_APACHE_EXECUTABLE=C:\xampp\apache\bin\httpd.exe
OSTR_APACHE_CONFIG_PATH=C:\xampp\apache\conf\httpd.conf

# Log do Apache no XAMPP; normalmente C:\xampp\apache\logs\error.log.
OSTR_WEB_ERROR_LOG_LOCAL=C:\xampp\apache\logs\error.log

# Raiz web confirmada pelo Apache. O osTicket ainda não foi implantado nela.
OSTR_DOCUMENT_ROOT_LOCAL=C:\xampp\htdocs

# Toolchain local do frontend. Obtenha os caminhos com Get-Command node e
# Get-Command pnpm. Não copie caminhos de perfil de outro usuário.
OSTR_NODE_EXECUTABLE=
OSTR_NODE_VERSION_OBSERVED=
OSTR_PNPM_EXECUTABLE=
OSTR_PNPM_VERSION_OBSERVED=
# O Angular CLI deverá ser dependência do projeto, executada via pnpm.
OSTR_ANGULAR_CLI_MODE=project-local

# Diagnóstico seguro esperado na homologação local.
OSTR_PHP_ERROR_REPORTING=E_ALL
OSTR_PHP_DISPLAY_ERRORS=false
OSTR_PHP_DISPLAY_STARTUP_ERRORS=false
OSTR_PHP_LOG_ERRORS=true

# Xdebug é opcional e deve ficar desabilitado até configurarmos rede e IDE.
OSTR_XDEBUG_ENABLED=false
OSTR_XDEBUG_CLIENT_HOST=
OSTR_XDEBUG_CLIENT_PORT=9003
OSTR_XDEBUG_IDEKEY=OSTICKET_REFORGED

# -----------------------------------------------------------------------------
# BANCO DE DADOS DE HOMOLOGAÇÃO — MariaDB 10.11
# -----------------------------------------------------------------------------
# Onde obter: administrador do banco ou painel da hospedagem. Use uma conta
# exclusiva de homologação. Não copie credenciais de produção.
OSTR_DB_ENGINE=mariadb
OSTR_DB_VERSION_EXPECTED=10.11
OSTR_DB_HOST=
OSTR_DB_PORT=3306
OSTR_DB_NAME=
OSTR_DB_USER=
OSTR_DB_PASSWORD=

# Modo TLS esperado: required, preferred ou disabled.
# Onde obter: administrador do banco/provedor. Prefira required quando suportado.
OSTR_DB_TLS_MODE=preferred

# Caminho local do certificado CA, se exigido. Não coloque o certificado inline.
OSTR_DB_TLS_CA_PATH=

# Barreira inicial: ferramentas de análise devem operar somente em leitura.
OSTR_DB_READ_ONLY=true

# Prefixo observado no include/ost-config.php instalado.
# Onde obter: constante TABLE_PREFIX da instalação de homologação.
OSTR_DB_TABLE_PREFIX=ost_

# -----------------------------------------------------------------------------
# IMPLANTAÇÃO LOCAL E BARREIRAS DE SEGURANÇA
# -----------------------------------------------------------------------------
# A estratégia de implantação local sob o Apache ainda será documentada.
OSTR_DEPLOY_PROTOCOL=local
OSTR_DEPLOY_DRY_RUN=true

# Deve permanecer false durante a preparação e a engenharia reversa.
OSTR_ALLOW_DATABASE_WRITE=false

# String de confirmação futura. Deixe vazia; uma ferramenta mutável deverá
# exigir valor explícito definido pelo procedimento aprovado.
OSTR_DEPLOY_CONFIRMATION=

# -----------------------------------------------------------------------------
# CONTAS FUNCIONAIS EXCLUSIVAS DE HOMOLOGAÇÃO
# -----------------------------------------------------------------------------
# Crie contas sem dados pessoais reais no painel do osTicket de homologação.
OSTR_TEST_AGENT_USERNAME=
OSTR_TEST_AGENT_PASSWORD=
OSTR_TEST_ADMIN_USERNAME=
OSTR_TEST_ADMIN_PASSWORD=
OSTR_TEST_CLIENT_EMAIL=
OSTR_TEST_CLIENT_PASSWORD=

# MFA: nunca armazene seed, segredo TOTP ou códigos de recuperação neste arquivo.
# Informe apenas se a conta de teste exige MFA; autenticação interativa será
# tratada separadamente.
OSTR_TEST_AGENT_MFA_ENABLED=false
OSTR_TEST_ADMIN_MFA_ENABLED=false

# -----------------------------------------------------------------------------
# E-MAIL DE TESTE — OPCIONAL
# -----------------------------------------------------------------------------
# Use caixa e servidor exclusivos de homologação ou capturador local.
# Onde obter: administrador de e-mail ou ferramenta de captura aprovada.
OSTR_MAIL_MODE=disabled
OSTR_SMTP_HOST=
OSTR_SMTP_PORT=587
OSTR_SMTP_USER=
OSTR_SMTP_PASSWORD=
OSTR_SMTP_ENCRYPTION=starttls
OSTR_IMAP_HOST=
OSTR_IMAP_PORT=993
OSTR_IMAP_USER=
OSTR_IMAP_PASSWORD=
OSTR_IMAP_ENCRYPTION=tls

# -----------------------------------------------------------------------------
# ARQUIVOS, ANEXOS E TESTES
# -----------------------------------------------------------------------------
# Diretório local para fixtures sem dados reais.
OSTR_TEST_FIXTURES_PATH=

# Limite conservador inicial para uploads de teste, em bytes.
OSTR_TEST_UPLOAD_MAX_BYTES=10485760

# Extensões e limites efetivos devem ser obtidos no painel do osTicket/PHP.
OSTR_PHP_UPLOAD_MAX_FILESIZE=40M
OSTR_PHP_POST_MAX_SIZE=40M

# -----------------------------------------------------------------------------
# OBSERVABILIDADE E RESULTADOS
# -----------------------------------------------------------------------------
# Diretório local ignorado pelo Git para relatórios e logs coletados.
OSTR_ARTIFACTS_PATH=.local/homologation-artifacts

# Remova ou masque cookies, tokens, senhas, e-mails e dados pessoais dos artefatos.
OSTR_REDACT_SENSITIVE_DATA=true
